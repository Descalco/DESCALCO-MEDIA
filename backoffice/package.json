{
  "name": "descalco-portfolio-backoffice",
  "version": "1.0.0",
  "description": "Backoffice system for Descalco Media portfolio management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "uploads/*",
      "*.json"
    ],
    "watch": [
      "server.js",
      "admin/*"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "fs-extra": "^11.1.1",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "portfolio",
    "cms",
    "backoffice",
    "express"
  ],
  "author": "Descalco Media",
  "license": "MIT"
}
